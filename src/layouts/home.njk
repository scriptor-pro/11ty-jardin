{% extends "base.njk" %}

{% block content %}
  {% set latestNote = collections.notes[0] %}
  {% set wanderNotes = collections.notesWithBacklinks | exceptNote(latestNote) | shuffle %}
  {% set wanderNote = wanderNotes[0] %}

  <div class="garden-home">
    <section class="welcome-hero" aria-labelledby="welcome-title">
      <div class="welcome-copy">
        <p class="home-eyebrow">Un jardin numérique · Bruxelles</p>
        <h2 id="welcome-title">Des idées à cueillir. Des chemins à suivre.</h2>
        <p class="welcome-description">Photo argentique, Linux, web et curiosités du quotidien : entre ici, prends ce qui t’intéresse, suis les liens et vois où ils te mènent.</p>
        <div class="welcome-actions">
          <a class="home-primary-link" href="/notes/">Entrer dans le jardin <span aria-hidden="true">→</span></a>
          <a class="welcome-secondary-link" href="#sentiers">Choisir un sujet</a>
        </div>
      </div>
      <figure class="welcome-image">
        <img src="/images/jardin-numerique.webp" alt="Des notes et des carnets réunis en un jardin d’idées." width="800" height="800" loading="eager" decoding="async">
        <figcaption>Un espace vivant, en chantier perpétuel.</figcaption>
      </figure>
    </section>

    <section class="garden-trails" id="sentiers" aria-labelledby="trails-title">
      <div class="section-heading">
        <p class="home-eyebrow">Pour commencer</p>
        <h2 id="trails-title">Choisis un sentier</h2>
        <p>Pas besoin de tout connaître du jardin. Une curiosité suffit.</p>
      </div>
      <div class="trail-grid">
        <a class="trail-card trail-photo" href="/tags/photo/">
          <span class="trail-number" aria-hidden="true">01</span>
          <h3>Photo argentique</h3>
          <p>Films, caffenol et expériences de petit chimiste dans la salle de bain.</p>
          <span class="trail-action">Voir les notes <span aria-hidden="true">↗</span></span>
        </a>
        <a class="trail-card trail-linux" href="/tags/linux/">
          <span class="trail-number" aria-hidden="true">02</span>
          <h3>Linux au quotidien</h3>
          <p>Commandes utiles, terminal et solutions aux petits problèmes concrets.</p>
          <span class="trail-action">Voir les notes <span aria-hidden="true">↗</span></span>
        </a>
        <a class="trail-card trail-web" href="/tags/web/">
          <span class="trail-number" aria-hidden="true">03</span>
          <h3>Le web à fabriquer</h3>
          <p>Sites, outils et jardins numériques : apprendre en construisant.</p>
          <span class="trail-action">Voir les notes <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </section>

    <section class="garden-discover" aria-label="Notes à découvrir">
      {% if latestNote %}
        <article class="discover-feature">
          <p class="home-eyebrow">La dernière pousse</p>
          <h2><a href="{{ latestNote.url }}">{{ latestNote.data.title }}</a></h2>
          {% if latestNote.data.description %}<p>{{ latestNote.data.description }}</p>{% endif %}
          <a class="text-link" href="{{ latestNote.url }}">Lire cette note <span aria-hidden="true">→</span></a>
        </article>
      {% endif %}
      {% if wanderNote %}
        <article class="discover-wander">
          <p class="home-eyebrow">Le détour du jour</p>
          <h2><a href="{{ wanderNote.url }}">{{ wanderNote.data.title }}</a></h2>
          {% if wanderNote.data.description %}<p>{{ wanderNote.data.description }}</p>{% endif %}
          <a class="text-link" href="{{ wanderNote.url }}">Je me laisse guider <span aria-hidden="true">→</span></a>
        </article>
      {% endif %}
    </section>

    <p class="garden-all-notes"><a href="/notes/">Parcourir les {{ collections.notesWithBacklinks | length }} notes du jardin <span aria-hidden="true">→</span></a></p>
  </div>
{% endblock %}
