{% extends "base.njk" %}

{% block content %}

  <div class="home-layout">

    {# ============================================================
       COLONNE GAUCHE — HERO / IDENTITÉ
       ============================================================ #}
    <header class="home-column home-column-left">
      <figure class="home-hero-image">
        <img 
          src="/images/jardin-numerique.webp"
          alt="Empilement ordonné de notes et de carnets, symbolisant une pratique continue de la prise de notes."
          loading="eager"
          decoding="async"
        >
      </figure>
    </header>

    {# ============================================================
       COLONNE DROITE — VIE DU JARDIN
       ============================================================ #}
    <aside class="home-column home-column-right">

      {# ---------------- Dernière note ---------------- #}
      <section class="home-latest" aria-labelledby="latest-note-heading">
        <h2 id="latest-note-heading" class="sr-only">Dernières notes publiées</h2>

        {% set latestNotes = collections.notes or [] %}

        {% if latestNotes and (latestNotes | length) > 0 %}
          <div class="latest-notes">
            {% for note in latestNotes %}
              {% if loop.index <= 2 %}
                <article class="latest-note">
                  {% if note.data.description %}
                    <p class="latest-note-title">{{ note.data.title }}</p>
                    {% set truncated = note.data.description | truncateAtPunctuation %}
                    <p class="latest-note-description">
                      {{ truncated.text }}
                      {% if truncated.lastWord %}
                        <a href="{{ note.url }}" class="last-word-link">
                          <em>{{ truncated.lastWord }}</em>
                        </a>
                      {% endif %}
                    </p>
                  {% else %}
                    <p class="latest-note-link">
                      <a href="{{ note.url }}">{{ note.data.title }}</a>
                    </p>
                  {% endif %}
                </article>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </section>

      {# ---------------- Nuage de tags ---------------- #}
      <section class="home-tags" aria-labelledby="tags-heading">
        <h2 id="tags-heading" class="sr-only">Explorer par tags</h2>

        {% set max = collections.tagListAlpha | maxBy("count") %}
        {% set min = collections.tagListAlpha | minBy("count") %}

        <nav class="tag-cloud-home" aria-label="Nuage de tags">
          <ul class="tag-cloud-list">
            {% for item in collections.tagListAlpha %}
              {% set ratio = (item.count - min) / (max - min + 0.0001) %}
              {% if ratio < 0.25 %}
                {% set weightClass = "tag-weight-1" %}
              {% elif ratio < 0.5 %}
                {% set weightClass = "tag-weight-2" %}
              {% elif ratio < 0.75 %}
                {% set weightClass = "tag-weight-3" %}
              {% else %}
                {% set weightClass = "tag-weight-4" %}
              {% endif %}
              <li>
                <a href="/tags/{{ item.tag | safelink }}/" class="{{ weightClass }}">
                  {{ item.tag }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      </section>

    </aside>

  </div>

{% endblock %}
