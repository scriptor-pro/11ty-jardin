#!/usr/bin/env bash
# jardin — écrire, publier, modifier et dépublier les notes de jndjs.dev
# depuis le terminal. Conception : docs/superpowers/specs/2026-11-14-jardin-cli-design.md
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
SITE="${JARDIN_SITE:-$(dirname "$SCRIPT_DIR")}"
BROUILLONS="${JARDIN_BROUILLONS:-$HOME/Documents/jardin-brouillons}"
URL="${JARDIN_URL:-https://jndjs.dev}"
TODAY="${JARDIN_TODAY:-$(date +%F)}"
BUILD_CMD="${JARDIN_BUILD_CMD:-npm run build}"
PREVIEW_CMD="${JARDIN_PREVIEW_CMD:-npm run dev}"
NOTES="$SITE/src/notes"

# --- utilitaires --------------------------------------------------------------

fm() { node "$SCRIPT_DIR/jardin-fm.mjs" "$@"; }
info() { printf '%s\n' "$*"; }
warn() { printf 'jardin : %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }
need() { local c; for c; do command -v "$c" >/dev/null || die "Dépendance manquante : $c"; done; }

# Évalué une fois au démarrage : dans une substitution $(…), stdout n'est plus un terminal.
INTERACTIVE=0
[[ ${JARDIN_YES:-} != 1 && -t 0 && -t 1 ]] && INTERACTIVE=1
interactive() { [[ $INTERACTIVE == 1 ]]; }

confirm() {
  [[ ${JARDIN_YES:-} == 1 ]] && return 0
  need gum
  gum confirm "$1"
}

edit_file() { ${EDITOR:-nano} "$1"; }

gsite() { git -C "$SITE" "$@"; }
gdraft() { git -C "$BROUILLONS" "$@"; }

# Pousse ; en cas de refus, un pull --rebase puis un seul nouvel essai.
# En cas de conflit, le rebase est annulé : le commit reste local.
push_repo() {
  git -C "$1" push -q 2>/dev/null && return 0
  if ! git -C "$1" pull -q --rebase; then
    git -C "$1" rebase --abort 2>/dev/null || true
    return 1
  fi
  git -C "$1" push -q
}

# Commit (et push) d'un seul fichier dans le dépôt des brouillons.
# Un échec du push n'est pas fatal : le brouillon reste commité localement.
draft_commit() { # fichier message
  gdraft add -A -- "$1"
  gdraft diff --cached --quiet -- "$1" && return 0
  gdraft commit -q -m "$2" -- "$1"
  push_repo "$BROUILLONS" || warn "brouillon commité mais non poussé (réessayer plus tard : git -C $BROUILLONS push)"
}

drafts_sync() { gdraft pull -q --rebase --autostash 2>/dev/null || warn "impossible de synchroniser les brouillons"; }

need_clean_site() {
  local dirty
  dirty="$(gsite status --porcelain)"
  [[ -z $dirty ]] || die "Le dépôt du site a des modifications non commitées :
$dirty
Les committer ou les annuler avant de continuer."
}

site_sync() { gsite pull -q --rebase || die "Impossible de synchroniser le dépôt du site (git pull --rebase)."; }

# Build complet du site ; affiche la fin du journal en cas d'échec.
control_build() {
  local log
  log="$(mktemp)"
  info "Build de contrôle…"
  if (cd "$SITE" && eval "$BUILD_CMD") >"$log" 2>&1; then
    rm -f "$log"
    return 0
  fi
  tail -n 20 "$log" >&2
  rm -f "$log"
  return 1
}

# Sha court affiché dans l'en-tête du site (.build-id)
live_sha() {
  curl -fsS --max-time 15 "$URL/?jardin=$RANDOM" 2>/dev/null |
    grep -oE 'build-id">[^<]*' | grep -oE '\([0-9a-f]+\)' | tr -d '()' || true
}

# Attend que le site affiche le commit poussé (toutes les 20 s, 8 min au plus).
wait_online() { # sha
  [[ ${JARDIN_NO_WAIT:-} == 1 ]] && return 0
  need curl
  local start=$SECONDS live
  trap 'echo; die "Attente interrompue : le push est fait, le site sera à jour dans quelques minutes."' INT
  info "Poussé. Attente de la mise en ligne (4 à 6 min en général)…"
  while ((SECONDS - start < 480)); do
    live="$(live_sha)"
    if [[ -n $live && $1 == "$live"* ]]; then
      trap - INT
      printf '\r\033[K'
      return 0
    fi
    printf '\r  %d s écoulées…' $((SECONDS - start))
    sleep 20
  done
  trap - INT
  echo
  return 1
}

# Pousse le dépôt du site puis attend la mise en ligne ; $1 = chemin d'URL à annoncer.
push_site_and_wait() {
  push_repo "$SITE" || die "Le commit est fait mais le push a échoué. Résoudre puis lancer : git -C $SITE push"
  wait_online "$(gsite rev-parse HEAD)" ||
    die "Poussé, mais pas encore en ligne après 8 min — vérifier statichost."
  [[ -n ${1:-} ]] && info "En ligne : $URL$1"
  return 0
}

slug_of() { local n="${1##*/}"; printf '%s' "${n%.md}"; }

# Écrit dans $2 le brouillon $1 avec le front matter complet d'une note publiée.
install_note() { fm complete "$1" "$2" "$TODAY"; } # brouillon cible

# --- sélection des notes ----------------------------------------------------

# Lignes « chemin<TAB>étiquette<TAB>titre » des candidats d'un type (draft|site|any)
candidates() {
  local kind="$1" files=() f
  if [[ $kind != site ]]; then
    for f in "$BROUILLONS"/*.md; do
      [[ -f $f && ${f##*/} != README.md ]] && files+=("$f")
    done
  fi
  if [[ $kind != draft ]]; then
    for f in "$NOTES"/*.md; do
      [[ -f $f && ${f##*/} != index.md ]] && files+=("$f")
    done
  fi
  [[ ${#files[@]} -eq 0 ]] && return 0
  fm list "${files[@]}" | while IFS=$'\t' read -r path title _created _tags publish; do
    local label="[en ligne]"
    if [[ $path == "$BROUILLONS"/* ]]; then label="[brouillon]"
    elif [[ $publish == false ]]; then label="[masquée]"
    fi
    printf '%s\t%s\t%s\n' "$path" "$label" "$title"
  done
}

# Choisit une note : chemin .md, slug exact, filtre partiel, ou fzf sans argument.
resolve() { # type [argument]
  local kind="$1" arg="${2:-}" list matches
  if [[ $arg == *.md && -f $arg ]]; then
    readlink -f "$arg"
    return
  fi
  list="$(candidates "$kind")"
  if [[ -z $list ]]; then
    [[ -n $arg ]] && die "Aucune note ne correspond à « $arg »."
    die "Aucune note disponible."
  fi

  if [[ -n $arg ]]; then
    matches="$(awk -F'\t' -v s="$arg" '{ n = $1; sub(/^.*\//, "", n); sub(/\.md$/, "", n) } n == s' <<<"$list")"
    if [[ -z $matches ]]; then
      local needle
      needle="$(fm slug "$arg")"
      matches="$(awk -F'\t' -v s="$needle" -v t="$(tr '[:upper:]' '[:lower:]' <<<"$arg")" \
        '{ n = $1; sub(/^.*\//, "", n) } index(n, s) || index(tolower($3), t)' <<<"$list")"
    fi
    [[ -n $matches ]] || die "Aucune note ne correspond à « $arg »."
    if [[ $(wc -l <<<"$matches") -eq 1 ]]; then
      cut -f1 <<<"$matches"
      return
    fi
    list="$matches"
  fi

  if ! interactive; then
    die "Plusieurs notes correspondent à « $arg » : $(cut -f3 <<<"$list" | paste -sd ',' | sed 's/,/, /g')"
  fi
  local choice
  need fzf glow
  choice="$(fzf --delimiter=$'\t' --with-nth=2,3 --query="$arg" --select-1 \
    --preview='glow -s dark {1}' --preview-window=right,60% <<<"$list")" || die "Aucune note choisie."
  cut -f1 <<<"$choice"
}

# --- sous-commandes -----------------------------------------------------------

cmd_new() {
  local title="${1:-}"
  [[ -n $title ]] || die 'Usage : jardin new "Titre"'
  local slug file template
  slug="$(fm slug "$title")"
  [[ -n $slug ]] || die "Titre sans caractère utilisable pour un nom de fichier."
  drafts_sync
  file="$BROUILLONS/$slug.md"
  [[ -e $file ]] && die "Un brouillon « $slug » existe déjà."
  [[ -e $NOTES/$slug.md ]] && die "Une note « $slug » existe déjà sur le site."

  fm new "$title" "$TODAY" > "$file"
  template="$(cat "$file")"
  edit_file "$file"
  if [[ "$(cat "$file")" == "$template" ]] && ! confirm "Le brouillon est resté vide. Le garder ?"; then
    rm -f "$file"
    info "Brouillon abandonné."
    return
  fi
  draft_commit "$file" "brouillon: \"$(fm get "$file" title)\""
  info "Brouillon enregistré : $file"
}

cmd_publish() {
  local file slug title errors target
  file="$(resolve draft "${1:-}")"
  [[ $file == "$BROUILLONS"/* ]] || die "« ${file##*/} » n'est pas un brouillon."
  slug="$(slug_of "$file")"
  title="$(fm get "$file" title)"
  errors="$(fm validate "$file" 2>&1)" || die "Brouillon « $slug » pas prêt : $errors"
  target="$NOTES/$slug.md"
  [[ -e $target ]] && die "Une note « $slug » existe déjà sur le site."

  interactive && need glow && glow "$file"
  confirm "Publier « $title » ?" || { info "Publication annulée."; return; }

  need_clean_site
  site_sync
  [[ -e $target ]] && die "Une note « $slug » existe déjà sur le site."

  # Le brouillon reste intact tant que la publication n'a pas abouti.
  install_note "$file" "$target"

  if ! control_build; then
    rm -f "$target"
    die "Le build a échoué : rien n'a été publié, le brouillon est intact."
  fi

  gsite add -- "$target"
  gsite commit -q -m "feat: publish \"$title\"" -- "$target"
  push_repo "$SITE" || die "Le commit est fait mais le push a échoué. Résoudre puis lancer : git -C $SITE push"

  gdraft rm -q -- "$file"
  gdraft commit -q -m "publié: \"$title\"" -- "$file"
  push_repo "$BROUILLONS" || warn "suppression du brouillon non poussée (git -C $BROUILLONS push)"

  wait_online "$(gsite rev-parse HEAD)" ||
    die "Poussé, mais pas encore en ligne après 8 min — vérifier statichost."
  info "En ligne : $URL/notes/$slug/"
}

cmd_edit() {
  local file
  file="$(resolve any "${1:-}")"
  if [[ $file == "$BROUILLONS"/* ]]; then
    edit_draft "$file"
  else
    edit_site_note "$file"
  fi
}

edit_draft() {
  local file="$1" before
  before="$(cat "$file")"
  edit_file "$file"
  if [[ "$(cat "$file")" == "$before" ]]; then
    info "Aucune modification."
    return
  fi
  draft_commit "$file" "brouillon: \"$(fm get "$file" title)\""
  info "Brouillon enregistré : $file"
}

edit_site_note() {
  local file="$1" before errors title hidden=false
  need_clean_site
  site_sync
  [[ -f $file ]] || die "« ${file##*/} » n'existe plus sur le site après synchronisation."
  before="$(cat "$file")"
  edit_file "$file"
  if [[ "$(cat "$file")" == "$before" ]]; then
    info "Aucune modification."
    return
  fi

  local kept="La modification est conservée, non commitée : $file"
  interactive && gsite --no-pager diff -- "$file"
  confirm "Mettre à jour en ligne ?" || { info "$kept"; return; }

  errors="$(fm validate "$file" 2>&1)" || die "Note invalide : $errors. $kept"
  fm set "$file" updated "$TODAY"
  control_build || die "Le build a échoué. $kept"

  title="$(fm get "$file" title)"
  [[ $(fm get "$file" publish) == false ]] && hidden=true
  gsite add -- "$file"
  gsite commit -q -m "content: mettre à jour \"$title\"" -- "$file"
  if $hidden; then
    push_repo "$SITE" || die "Le commit est fait mais le push a échoué. Résoudre puis lancer : git -C $SITE push"
    info "Mise à jour poussée (note masquée : pas de vérification en ligne)."
  else
    push_site_and_wait "/notes/$(slug_of "$file")/"
  fi
}

cmd_unpublish() {
  local file slug title draft hidden=false
  file="$(resolve site "${1:-}")"
  [[ $file == "$NOTES"/* ]] || die "« ${file##*/} » n'est pas une note du site."
  slug="$(slug_of "$file")"
  title="$(fm get "$file" title)"
  draft="$BROUILLONS/$slug.md"
  [[ -e $draft ]] && die "Un brouillon « $slug » existe déjà : le renommer ou le supprimer d'abord."
  confirm "Dépublier « $title » ?" || { info "Dépublication annulée."; return; }

  need_clean_site
  site_sync
  [[ -f $file ]] || die "« $slug » n'existe plus sur le site après synchronisation."
  drafts_sync
  [[ -e $draft ]] && die "Un brouillon « $slug » existe déjà : le renommer ou le supprimer d'abord."
  [[ $(fm get "$file" publish) == false ]] && hidden=true

  # Brouillon sauvegardé d'abord : le texte n'est jamais perdu.
  cp "$file" "$draft"
  draft_commit "$draft" "brouillon: dépublié \"$title\""

  gsite rm -q -- "$file"
  gsite commit -q -m "chore: unpublish \"$title\"" -- "$file"
  if $hidden; then
    push_repo "$SITE" || die "Le commit est fait mais le push a échoué. Résoudre puis lancer : git -C $SITE push"
  else
    push_site_and_wait ""
    if [[ ${JARDIN_NO_WAIT:-} != 1 ]] &&
      [[ $(curl -s -o /dev/null -w '%{http_code}' "$URL/notes/$slug/?jardin=$RANDOM") == 200 ]]; then
      warn "$URL/notes/$slug/ répond encore : vérifier statichost."
    fi
  fi
  info "Dépubliée : « $title » est de nouveau un brouillon ($draft)."
}

cmd_preview() {
  if [[ -z ${1:-} ]]; then
    cd "$SITE" && eval "exec $PREVIEW_CMD"
  fi
  local file slug
  file="$(resolve draft "$1")"
  [[ $file == "$BROUILLONS"/* ]] || die "« ${file##*/} » n'est pas un brouillon (pour une note en ligne : jardin preview)."
  slug="$(slug_of "$file")"
  # Globales : le piège EXIT s'exécute hors de cette fonction.
  PV_TARGET="$NOTES/$slug.md"
  [[ -e $PV_TARGET ]] && die "Une note « $slug » existe déjà sur le site (ou un aperçu interrompu : $PV_TARGET)."

  # Copie temporaire dans le site, retirée à l'arrêt quoi qu'il arrive.
  PV_STAGED="$(mktemp)"
  PV_POLLER=""
  trap '[[ -n $PV_POLLER ]] && kill "$PV_POLLER" 2>/dev/null; rm -f "$PV_TARGET" "$PV_STAGED"' EXIT
  local last
  last="$(stat -c %y "$file")" # relevé avant la copie : aucune modification ne peut passer entre les deux
  install_note "$file" "$PV_STAGED" && cat "$PV_STAGED" >"$PV_TARGET"

  # Recopie le brouillon à chaque modification (mtime en nanosecondes).
  # Détachée de stdout/stderr pour ne retenir aucun tube ouvert.
  (
    while sleep 1; do
      now="$(stat -c %y "$file" 2>/dev/null)" || continue
      [[ $now == "$last" ]] && continue
      last="$now"
      install_note "$file" "$PV_STAGED" && cat "$PV_STAGED" >"$PV_TARGET"
    done
  ) >/dev/null 2>"${JARDIN_DEBUG_POLLER:-/dev/null}" &
  PV_POLLER=$!

  info "Aperçu de « $(fm get "$file" title) » : http://localhost:8080/notes/$slug/"
  info "Les modifications du brouillon sont reprises en direct. Ctrl-C pour arrêter."
  (cd "$SITE" && eval "$PREVIEW_CMD")
}

cmd_drafts() {
  local files=() f
  for f in "$BROUILLONS"/*.md; do
    [[ -f $f && ${f##*/} != README.md ]] && files+=("$f")
  done
  if [[ ${#files[@]} -eq 0 ]]; then
    info "Aucun brouillon."
    return
  fi
  fm list "${files[@]}" | sort -t $'\t' -k3,3r |
    awk -F'\t' '{ n = $1; sub(/^.*\//, "", n); sub(/\.md$/, "", n);
                  printf "%-10s  %s%s  (%s)\n", $3, $2, ($4 ? "  [" $4 "]" : ""), n }'
}

cmd_help() {
  cat <<'EOF'
jardin — publier le jardin numérique depuis le terminal

  jardin new "Titre"        crée un brouillon et l'ouvre dans l'éditeur
  jardin drafts             liste les brouillons
  jardin edit [note]        modifie un brouillon ou une note en ligne
  jardin publish [note]     publie un brouillon
  jardin unpublish [note]   ramène une note en ligne dans les brouillons
  jardin preview [note]     aperçu local : le site, ou un brouillon dans le site

[note] : slug, partie du titre ou chemin .md ; sans argument, sélection avec fzf.
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  need git node
  case "$cmd" in
    new) cmd_new "$@" ;;
    drafts) cmd_drafts ;;
    edit) cmd_edit "$@" ;;
    publish) cmd_publish "$@" ;;
    unpublish) cmd_unpublish "$@" ;;
    preview) cmd_preview "$@" ;;
    help | -h | --help) cmd_help ;;
    *) cmd_help >&2; die "Commande inconnue : $cmd" ;;
  esac
}

main "$@"
